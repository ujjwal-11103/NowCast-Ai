server {
    listen 80;
    listen [::]:80;
    
    # Replace with your domain name or use the IP address
    server_name 20.235.178.245;
    
    # Document root - where the built files are located
    root /var/www/NowCast-Ai/dist;
    index index.html;
    
    # Logging
    access_log /var/log/nginx/nowcast-ai-access.log;
    error_log /var/log/nginx/nowcast-ai-error.log;
    
    # Gzip compression for better performance
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types 
        text/plain 
        text/css 
        text/xml 
        text/javascript 
        application/x-javascript 
        application/xml+rss 
        application/javascript 
        application/json
        application/xml
        image/svg+xml;
    
    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    
    # Main location - serve static files and handle SPA routing
    location / {
        try_files $uri $uri/ /index.html;
        
        # Cache static assets
        location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
        }
    }
    
    # API proxy configuration
    location /api {
        proxy_pass https://nowcast.intellimark.ai;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
    
    # Data API proxy
    location /data-api {
        proxy_pass https://nowcast.intellimark.ai;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    
    # Explorer proxy
    location /explorer {
        proxy_pass https://nowcast.intellimark.ai;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    
    # Alfred service proxy
    location /alfred {
        proxy_pass http://13.71.126.202:8085;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        
        # Handle CORS if needed
        add_header Access-Control-Allow-Origin * always;
    }
    
    # Neptune service proxy
    location /neptune {
        proxy_pass http://13.71.126.202:8082;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    
    # TP Optimization proxy with WebSocket support
    location /tp-optimisation {
        proxy_pass http://52.172.42.245:5005;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        
        # Remove X-Frame-Options to allow iframe embedding
        proxy_hide_header X-Frame-Options;
    }
    
    # Static assets from TP Optimization service
    location /static {
        proxy_pass http://52.172.42.245:5005;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }
    
    location /manifest.json {
        proxy_pass http://52.172.42.245:5005;
        proxy_http_version 1.1;
    }
    
    location /favicon.ico {
        proxy_pass http://52.172.42.245:5005;
        proxy_http_version 1.1;
    }
    
    location /logo192.png {
        proxy_pass http://52.172.42.245:5005;
        proxy_http_version 1.1;
    }
    
    # Deny access to hidden files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}

